# Server & CORS
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL + pgvector inside Docker)
# Set a strong password, e.g. the output of: python -c "import secrets; print(secrets.token_urlsafe(24))"
# The API builds its connection URL from these values. DATABASE_URL, if set, overrides them.
POSTGRES_USER=promptdox
POSTGRES_PASSWORD=
POSTGRES_DB=promptdox
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Auth & Security (Needed if handling Google OAuth + Email login on FastAPI)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Sign-In (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Email (SMTP for Email Sign-In / Magic Link / OTP Verification)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PromptDox <your-email@gmail.com>

# AI & RAG Pipeline (Google Gemini - Free Tier)
GEMINI_API_KEY=
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
CHAT_MODEL=gemini-3.5-flash
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=4

# Optional (defaults shown)
APP_ENV=development
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
REFRESH_TOKEN_EXPIRE_DAYS=30
